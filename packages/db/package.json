    "migrate": "node --import tsx src/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
